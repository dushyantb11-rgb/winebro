rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    function optStr(d, k, max) { return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max); }
    function optBool(d, k) { return !(k in d) || d[k] == null || d[k] is bool; }
    function optInt(d, k, lo, hi) { return !(k in d) || d[k] == null || (d[k] is int && d[k] >= lo && d[k] <= hi); }
    function validJournal(d, uid, entryId) {
      return d.id == entryId && d.userId == uid
        && d.productName is string && d.productName.size() > 0 && d.productName.size() <= 200
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.createdAt is string && d.createdAt.size() <= 40
        && optStr(d, 'productId', 120) && optStr(d, 'category', 64) && optStr(d, 'region', 120)
        && optStr(d, 'notes', 4000) && optStr(d, 'foodPaired', 200) && optStr(d, 'occasion', 64)
        && optStr(d, 'bottlePhotoUrl', 1000) && optStr(d, 'labelPhotoUrl', 1000) && optStr(d, 'notesAudioUrl', 1000)
        && optInt(d, 'pairingRating', 1, 5)
        && optBool(d, 'isFavorite') && optBool(d, 'isWishlist') && optBool(d, 'buyAgain');
    }


    // ─── USERS ────────────────────────────────────────────
    match /users/{uid} {
      // Users can only read/write their own document
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasAll(['displayName', 'isAgeVerified'])
                    && request.resource.data.isAgeVerified == true;
      allow update: if request.auth != null && request.auth.uid == uid
                    // Prevent changing auth-related or server-owned fields
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'createdAt', 'isAdmin', 'phoneIndexed']);

      // ─── JOURNAL ENTRIES ──────────────────────────────
      match /journal/{entryId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
                      && validJournal(request.resource.data, uid, entryId);
        allow update: if request.auth != null && request.auth.uid == uid
                      && validJournal(request.resource.data, uid, entryId)
                      && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // ─── CROSS-CATEGORY (D5 — cross-category graph) ───
      match /cross_category/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid
                     && request.resource.data.categories is list;
      }

      // ─── PRE-QUIZ SEED (D8 — discovery sequences) ─────
      match /pre_quiz_seed/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid
                     && request.resource.data.productIds is list;
      }

      // ─── AROMA CALIBRATION (D3) ───────────────────────
      match /aroma_calibration/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
                      && request.resource.data.keys().hasAll(['sessionId', 'responses']);
        allow update, delete: if false;
      }

      // ─── FRIENDS (S5.2 friend graph) ──────────────────
      match /friends/{friendUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid
                     && (
                          (request.method == 'delete')
                          ||
                          (request.resource.data.uid == friendUid
                           && request.resource.data.followedAt is string)
                        );
      }

      // ─── WISHLIST (Save for later) ─────────────────────
      match /wishlist/{productId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
                      && request.resource.data.productId == productId
                      && request.resource.data.productName is string;
      }

      // ─── FCM TOKEN (personal push: streak, restock, feedback) ──
      // Written by the device; read by Cloud Functions (admin).
      match /fcm_token/{docId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
                              && request.resource.data.token is string;
      }

      // ─── GAMIFICATION STATE ───────────────────────────
      match /gamification/{docId} {
        // Computed by CF-02 from users/{uid}/events; never written by the app.
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      match /events/{eventId} {
        // Append-only action log (scan, journalEntry, pairing). CF-02 marks processedAt.
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
                      && request.resource.data.type in ['scan', 'journalEntry', 'pairing']
                      && request.resource.data.createdAt == request.time
                      && !('processedAt' in request.resource.data)
                      && !('xpAwarded' in request.resource.data)
                      && (!('category' in request.resource.data) || (request.resource.data.category is string && request.resource.data.category.size() <= 64))
                      && (!('withFoodPairing' in request.resource.data) || request.resource.data.withFoodPairing is bool);
        allow update, delete: if false;
      }

      match /private/{docId} {
        allow read, write: if false; // server-side counters (rate limits)
      }
    }

    // ─── PRODUCTS (read-only, seeded by admin) ──────────
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK only
    }

    // ─── DISHES (read-only, seeded by admin) ─────────────
    match /dishes/{dishId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK only
    }

    // ─── COMMUNITY SIGNALS (Bro Circle counters) ─────────
    // Public aggregates written by CF-11 (admin only). Any signed-in
    // user can read for the Bro Circle on Home.
    match /community_signals/{productId} {
      allow read: if request.auth != null;
      allow write: if false; // CF-11 admin SDK only
    }

    // ─── PHONE INDEX (S5.2 friend discovery) ─────────────
    // Hash → uid lookup. Each user writes their OWN hash on sign-in.
    // Reads are restricted to whereIn batches (caps brute-force scan).
    // The hash is sha256(E.164 phone) — irreversible without the
    // original number.
    match /phone_index/{hash} {
      // Keyed by a peppered HMAC; written and read only by CF-13 callables.
      allow read, write: if false;
    }

    // ─── PAIRING FEEDBACK (D6 — pairing success rate) ────
    // Per-user response to "Did Bro get it right?". Each user
    // owns docs whose id is `{uid}_{entryId}`; ownership enforced
    // via the userId field. Only the user can read their feedback;
    // CF-09/engine read via Admin SDK. Aggregates are append-only
    // counter docs maintained client-side via transaction.
    match /pairing_feedback/{feedbackId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null
                   && request.resource.data.userId == request.auth.uid
                   && feedbackId == request.auth.uid + '_' + request.resource.data.entryId
                   && request.resource.data.entryId is string
                   && request.resource.data.productId is string
                   && request.resource.data.response in ['yes', 'maybe', 'no']
                   && !('applied' in request.resource.data)
                   && !('appliedAt' in request.resource.data);
      allow delete: if false;
    }

    match /pairing_aggregates/{aggregateId} {
      // Computed by CF-12b from pairing_feedback; the app only reads.
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── APP CONFIG (rules, reference lists) ─────────────
    // Read by the app before sign-in (quiz, categories); written only
    // by the admin API through the Admin SDK.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── CONSOLE DRAFTS & RELEASES (admin preview only) ────
    // Written by the admin API; readable in the app by admins who switch
    // on "Preview console drafts". Never by ordinary users.
    match /drafts_products/{id} { allow read: if isAdmin(); allow write: if false; }
    match /drafts_dishes/{id} { allow read: if isAdmin(); allow write: if false; }
    match /drafts_config/{id} { allow read: if isAdmin(); allow write: if false; }
    match /releases/{id} { allow read: if isAdmin(); allow write: if false; }
    match /catalogue_history/{id}/{document=**} { allow read, write: if false; }

    // ─── DENY ALL OTHER PATHS ────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
